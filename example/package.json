{
  "name": "example-todo-app",
  "version": "0.1.0",
  "description": "Example Next.js TODO app built against the locally built nextlove.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "build:openapi": "nextlove generate-openapi --packageDir . --apiName 'Example TODO API' --outputFile ./openapi.json",
    "build:type": "nextlove generate-route-types --packageDir .",
    "build:routespecs": "nextlove extract-route-specs --packageDir . --allowed-import-patterns '**/lib/zod.ts' --allowed-import-patterns '**/pages/api/**/*.ts' --outputFile dist/extracted-route-specs.mjs",
    "pretest": "npm run build",
    "test": "ava",
    "ava": "ava"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "next": "^16.0.0",
    "nextlove": "file:..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^8.3.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qs": "^6.9.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ava": "^5.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^2.7.1",
    "qs": "^6.11.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
