{
  "name": "nextlove-monorepo",
  "version": "0.0.1",
  "description": "Monorepo for the nextlove package and its example app.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "homepage": "https://github.com/seamapi/nextlove",
  "bugs": "https://github.com/seamapi/nextlove/issues",
  "repository": "seamapi/nextlove",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "scripts": {
    "build": "npm run build --workspace nextlove && npm run build --workspace example-todo-app",
    "dev": "npm run dev --workspace example-todo-app",
    "typecheck": "npm run typecheck --workspace nextlove",
    "pretest": "npm run build",
    "test": "npm test --workspace nextlove && npm test --workspace example-todo-app",
    "lint": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "example:start": "npm run start --workspace example-todo-app",
    "example:build:openapi": "npm run build:openapi --workspace example-todo-app",
    "example:build:type": "npm run build:type --workspace example-todo-app",
    "example:build:routespecs": "npm run build:routespecs --workspace example-todo-app",
    "example:test": "npm run build && npm run ava --workspace example-todo-app",
    "example:test-only:fast": "npm run ava --workspace example-todo-app",
    "example:test-only": "npm run build --workspace example-todo-app && npm run ava --workspace example-todo-app"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0 || ^22.0.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.0.0"
    }
  },
  "overrides": {
    "glob-promise": {
      "glob": "^7.2.0"
    }
  },
  "devDependencies": {
    "@types/node": "^20.8.6",
    "cpy-cli": "^4.2.0",
    "eslint-config-custom": "*",
    "prettier": "^2.7.1",
    "semantic-release": "^25.0.8"
  }
}
